{
  "name": "personal-budget-tracker-ru",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1 --port 4317",
    "preview": "vite preview --host 127.0.0.1 --port 4317",
    "lint": "eslint api scripts tests service-worker.js *.config.js *.config.mjs",
    "test": "npm run test:core && npm run test:worker && npm run test:ui && npm run test:offline",
    "test:core": "vitest run --config vitest.core.config.mjs",
    "test:worker": "vitest run --config vitest.config.mjs",
    "test:ui": "playwright test",
    "test:offline": "playwright test --config playwright.offline.config.js",
    "check:worker": "wrangler deploy --dry-run --config .codex-local/cloudflare-api/wrangler.jsonc --outdir output/worker-dry-run",
    "check:worker:ci": "wrangler deploy --dry-run --config api/wrangler.test.jsonc --outdir output/worker-ci-dry-run",
    "smoke:production": "node tests/production-smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.7.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  }
}
